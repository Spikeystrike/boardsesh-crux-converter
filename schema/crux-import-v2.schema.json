{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Spikeystrike/boardsesh-crux-converter/raw/main/schema/crux-import-v2.schema.json",
  "title": "CRUX climb import file v2",
  "description": "Versioned interchange file generated from a BoardSesh MoonBoard snapshot with per-climb foot rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "generated_at", "source", "target", "options", "summary", "climbs"],
  "properties": {
    "format": {"const": "crux-climb-import"},
    "version": {"const": 2},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {"$ref": "#/$defs/source"},
    "target": {"$ref": "#/$defs/target"},
    "options": {"$ref": "#/$defs/options"},
    "summary": {"$ref": "#/$defs/summary"},
    "climbs": {"type": "array", "items": {"$ref": "#/$defs/climb"}}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "footRule": {
      "enum": [
        "feet_follow_hands",
        "any_feet",
        "campus",
        "feet_follow_hands_open_kicker",
        "only_marked_feet"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "manifest_url", "snapshot_url", "snapshot_built_at", "board_type", "layout_id", "setup"],
      "properties": {
        "provider": {"const": "BoardSesh"},
        "manifest_url": {"type": "string", "format": "uri"},
        "snapshot_url": {"type": "string", "format": "uri"},
        "snapshot_built_at": {"type": "string"},
        "board_type": {"const": "moonboard"},
        "layout_id": {"type": "integer", "minimum": 1},
        "setup": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "wall_id", "mapping_id", "mapping_name"],
      "properties": {
        "provider": {"const": "CRUX"},
        "wall_id": {"type": "integer", "minimum": 1},
        "mapping_id": {"type": "string"},
        "mapping_name": {"type": "string"}
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade_system", "foot_rules", "incomplete_climbs"],
      "properties": {
        "grade_system": {"enum": ["font", "v_scale", "boardsesh"]},
        "foot_rules": {"const": "derived_from_boardsesh_characteristics"},
        "incomplete_climbs": {"const": "skip"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_climbs",
        "included_climbs",
        "skipped_missing_mapping",
        "skipped_invalid_frames",
        "skipped_unsupported_foot_rule",
        "climbs_without_grade",
        "crux_role_collisions",
        "foot_rule_counts",
        "skipped_examples"
      ],
      "properties": {
        "input_climbs": {"type": "integer", "minimum": 0},
        "included_climbs": {"type": "integer", "minimum": 0},
        "skipped_missing_mapping": {"type": "integer", "minimum": 0},
        "skipped_invalid_frames": {"type": "integer", "minimum": 0},
        "skipped_unsupported_foot_rule": {"type": "integer", "minimum": 0},
        "climbs_without_grade": {"type": "integer", "minimum": 0},
        "crux_role_collisions": {"type": "integer", "minimum": 0},
        "foot_rule_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "feet_follow_hands": {"type": "integer", "minimum": 0},
            "any_feet": {"type": "integer", "minimum": 0},
            "campus": {"type": "integer", "minimum": 0},
            "feet_follow_hands_open_kicker": {"type": "integer", "minimum": 0},
            "only_marked_feet": {"type": "integer", "minimum": 0}
          }
        },
        "skipped_examples": {"type": "array", "items": {"type": "object"}}
      }
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hold_type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "hold_type": {"enum": ["hand", "hand_l", "hand_r", "foot", "foot_l", "foot_r", "start", "finish", "zone"]}
      }
    },
    "climbSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "climb_uuid",
        "layout_id",
        "angle",
        "display_difficulty",
        "is_benchmark",
        "ascensionist_count",
        "quality_average",
        "characteristics"
      ],
      "properties": {
        "provider": {"const": "BoardSesh"},
        "climb_uuid": {"type": "string", "minLength": 1},
        "layout_id": {"type": "integer", "minimum": 1},
        "angle": {"type": "integer", "minimum": 0, "maximum": 90},
        "display_difficulty": {"type": ["number", "null"]},
        "is_benchmark": {"type": "boolean"},
        "ascensionist_count": {"type": "integer", "minimum": 0},
        "quality_average": {"type": ["number", "null"]},
        "characteristics": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "climb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_id", "name", "description", "grade", "angle", "color", "foot_rules", "setter_name", "holds", "source"],
      "properties": {
        "external_id": {"type": "string", "pattern": "^boardsesh:.+:[0-9]+$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"$ref": "#/$defs/nullableString"},
        "grade": {"$ref": "#/$defs/nullableString"},
        "angle": {"type": "string", "pattern": "^[0-9]+$"},
        "color": {"$ref": "#/$defs/nullableString"},
        "foot_rules": {"$ref": "#/$defs/footRule"},
        "setter_name": {"$ref": "#/$defs/nullableString"},
        "holds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hold"}},
        "source": {"$ref": "#/$defs/climbSource"}
      }
    }
  }
}
